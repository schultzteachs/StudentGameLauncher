<Window x:Class="Launcher1._0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher1._0"
        mc:Ignorable="d"
        Title="Student Game Launcher" Height="550" Width="900" Background="#121212"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="Purple"/>

        <Style x:Key="UtilityItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#222"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="MediumPurple"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GameCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10,0,10,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="WhiteSmoke"/>
                    <Setter Property="BorderThickness" Value="6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="White" FontSize="24" FontWeight="Bold" Margin="25,25,25,15">
            <Run Text="{Binding SchoolName}"/> 
            <Run Text="Student Game Launcher"/>
        </TextBlock>
        <TextBlock Grid.Row="0" Text="Schultz" Foreground="Gray" FontSize="10"  HorizontalAlignment="Right" Margin="0,0,0,0" />

        <ListBox x:Name="Options" Grid.Row="1" 
                 SelectedIndex="0"
                 ItemContainerStyle="{StaticResource UtilityItemStyle}"
                 KeyDown="Options_KeyDown" PreviewMouseLeftButtonUp="Options_MouseClick"
                 Background="Transparent" BorderThickness="0" Margin="25,0,25,20">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBoxItem Content="Rescan Games"/>
            <ListBoxItem Content="Edit Game Meta-data"/>
            <ListBoxItem Content="Launcher Settings"/>
        </ListBox>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden">

            <ListBox x:Name="MenuBox" 
                     ItemsSource="{Binding MasterGameList}" 
                     ItemContainerStyle="{StaticResource GameCardItemStyle}"
                     SelectedIndex="-1" 
                     Background="Transparent" BorderThickness="0" Padding="15,10">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder" Padding="12" Width="210" Height="280" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="120"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="4" ClipToBounds="True">
                                    <Image Source="{Binding ThumbnailPath, TargetNullValue='pack://application:,,,/Assets/defaultthumb.png', FallbackValue='pack://application:,,,/Assets/defaultthumb.png'}" 
                                           Stretch="UniformToFill"/>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding AuthorNames}" Foreground="#DDDDDD" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Row="1" Content="LAUNCH" Height="32"
                                            Background="Black" Foreground="White" FontWeight="SemiBold"
                                            Click="PlayButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</Window>