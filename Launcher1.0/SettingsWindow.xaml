<Window x:Class="Launcher1._0.SettingsWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Settings" Height="400" Width="400" 
        Background="#1E1E1E" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Settings" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="School Name:" Foreground="Gray" Margin="0,0,0,5"/>
            <TextBox x:Name="SchoolNameTextBox" Padding="5" Background="#2D2D2D" Foreground="White" BorderBrush="#555" Margin="0,0,0,10"/>

            <TextBlock Text="App Background Color:" Foreground="Gray" Margin="0,0,0,5"/>
            <!-- Added Toolkit ColorPicker here -->
            <xctk:ColorPicker Name="BgColorPicker" Margin="0,0,0,15" SelectedColorChanged="BgColorPicker_SelectedColorChanged" />

            <TextBlock Text="Game Card Color:" Foreground="Gray" Margin="0,0,0,5"/>
            <xctk:ColorPicker Name="CardColorPicker" Margin="0,0,0,15" SelectedColorChanged="CardColorPicker_SelectedColorChanged" />

            <Button Content="Save Settings" Margin="0,30,0,0" Height="35" Background="#007ACC" Foreground="White" FontWeight="Bold" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
